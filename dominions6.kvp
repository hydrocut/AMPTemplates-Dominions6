Meta.DisplayName=Dominions 6 (TeamKit)
Meta.Description=Serveur multijoueur de Dominions 6 - Rise of the Pantokrator (Illwinter, jeu PAYANT, Steam 2511500) : le jeu lui-meme lance sans affichage (--tcpserver --textonly). Les fichiers viennent de SteamCMD avec un compte Steam qui possede le jeu, ou d'une copie manuelle du dossier Steam. Tours simultanes avec delai reglable, pense pour les parties longues entre membres. Un seul port TCP. Pas de liste de joueurs dans AMP : le jeu n'ecrit pas qui se connecte.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Dominions6
Meta.DisplayImageSource=steam:2511500
Meta.EndpointURIFormat=
Meta.ConfigManifest=dominions6config.json
Meta.MetaConfigManifest=dominions6metaconfig.json
Meta.ConfigRoot=dominions6.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Le binaire Linux de Dominions 6 a besoin de SDL2, OpenGL et GLU meme sans affichage, et le lanceur de Python 3 : ExtraContainerPackages les installe dans le conteneur.
Meta.ExtraSetupStepsURI=https://www.illwinter.com/dom6/docs.html
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["libsdl2-2.0-0","libgl1","libglu1-mesa","python3"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=d49b207b-f00b-493a-87f3-969870dbda6a
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
